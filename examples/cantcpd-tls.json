{
  "listen": "0.0.0.0:29536",
  "can": {
    "interface": "can0",
    "error_frames": false
  },
  "tls": {
    "cert_file": "/etc/cantcp/tls/server.pem",
    "key_file": "/etc/cantcp/tls/server-key.pem",
    "ca_file": "/etc/cantcp/tls/ca.pem",
    "client_auth": "require_and_verify"
  },
  "limits": {
    "max_connections": 16,
    "client_queue": 1024,
    "read_timeout": "5s",
    "write_timeout": "5s",
    "idle_timeout": "1m",
    "max_frames_per_second": 5000
  },
  "stats": {
    "enable": true,
    "listen": "127.0.0.1:29537"
  },
  "log": {
    "level": "info",
    "format": "json"
  }
}
